rules_version = '2';

// ============================================================
// Reglas Firestore Valquirias TLV — v3 (SIN Cloud Functions)
// ============================================================
//
// Modelo de auth simplificado (sin custom claims):
// - Todos entran con Firebase Auth (Magic Link).
// - La whitelist real vive en Firestore doc `config` → campo `whitelist`.
// - Estas rules controlan solo qué email puede leer/escribir qué doc.
// - El bloqueo whitelistActiva=false lo hace el cliente en LoginMagicLink.jsx
//   (después signOut si no está autorizada).
//
// Estructura Firestore actual:
//   colección `televentas` con 5 docs:
//     - registros   (llenados por Carolina y Luis)
//     - metas       (cargadas por Luis, incluye ventas sincronizadas de systemlap)
//     - vendedoras  (roster + emails privados)
//     - snapshots   (meses cerrados, generados por Luis)
//     - config      (whitelist, whitelistActiva, premiosTrim, rankingVisible)
//
// Emails privilegiados (hardcoded):
//   Luis      → luisponce.tv@gmail.com     — admin (write TODO)
//   Carolina  → info@televentas.com        — oficina (write registros y metas)
//
// Vendedoras (13): lectura de todos los docs — necesario para ver ranking,
// nota, ventas propias, config de premios trimestrales, etc.
// Los DATOS SENSIBLES personales de cada vendedora deben quedar en su UI,
// no en un doc separado (mismo modelo que la app vieja).

function esAdmin() {
  return request.auth != null
      && request.auth.token.email == 'luisponce.tv@gmail.com';
}

function esOficina() {
  return request.auth != null
      && request.auth.token.email == 'info@televentas.com';
}

function autenticado() {
  return request.auth != null && request.auth.token.email != null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Colección principal ----------
    match /televentas/{docId} {

      // LECTURA: cualquier autenticado.
      // (La validación fina — quién ES esta persona, qué puede ver — la hace el cliente.
      // La whitelist en config decide si el login se completa; si no, signOut inmediato.)
      allow read: if autenticado();

      // ESCRITURA por doc:
      // - vendedoras + snapshots: solo admin (Luis)
      // - registros: admin u oficina (Carolina llena diario)
      // - metas: admin u oficina (Carolina puede corregir ventas)
      // - config: solo admin
      allow write: if (docId == 'vendedoras'  && esAdmin())
                   || (docId == 'snapshots'   && esAdmin())
                   || (docId == 'config'      && esAdmin())
                   || (docId == 'registros'   && (esAdmin() || esOficina()))
                   || (docId == 'metas'       && (esAdmin() || esOficina()));
    }

    // ---------- Log de accesos (fase 2, cuando activemos Blaze) ----------
    match /accesos_log/{logId} {
      allow read: if esAdmin();
      allow write: if false; // solo Cloud Functions escriben aquí (aún no existen)
    }

    // ---------- Deny-all al final: cualquier otra ruta bloqueada ----------
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
